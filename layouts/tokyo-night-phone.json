{
  "id": "root",
  "type": "row",
  "titlebar": "none",
  "theme": "tokyo-night",
  "background": { "image": "mods/tokyo-night/wallpaper.png", "fit": "cover" },
  "resizable": false,
  "terminal_padding": [10, 12],
  "terminal_opacity": 0.82,
  "preview": "layouts/tokyo-night-phone.svg",
  "ui_font": "Inter",
  "font": "JetBrains Mono",
  "font_size": 12,
  "children": [
    {
      "id": "phone",
      "type": "column",
      "children": [
        {
          "id": "core",
          "type": "column",
          "gap": 6,
          "resizable": false,
          "children": [
            {
              "id": "topbar",
              "type": "block",
              "size": { "px": 52 },
              "content": { "mod": "tokyo-night-phone", "props": { "role": "topbar", "fit_zoom": true } }
            },
            {
              "id": "drawer",
              "type": "block",
              "hidden": true,
              "size": { "px": 360 },
              "content": { "mod": "tokyo-night-phone", "props": { "role": "drawer" } }
            },
            {
              "id": "strip",
              "type": "block",
              "hidden": true,
              "size": { "px": 28 },
              "content": { "mod": "tokyo-night-phone", "props": { "role": "strip" } }
            },
            {
              "id": "tabs",
              "type": "block",
              "size": { "px": 40 },
              "content": { "mod": "tokyo-night-phone", "props": { "role": "tabs" } }
            },
            {
              "id": "term",
              "type": "column",
              "padding": [0, 8],
              "children": [
                {
                  "id": "main",
                  "type": "block",
                  "content": {
                    "tab": "active",
                    "pane": {
                      "gap": 6,
                      "radius": 12,
                      "background": "surface",
                      "lone": true,
                      "border": { "width": 1, "color": "border" },
                      "focus": { "width": 1, "color": "#ffffff40" }
                    }
                  }
                }
              ]
            },
            {
              "id": "composer",
              "type": "block",
              "hidden": true,
              "size": { "px": 44 },
              "content": { "mod": "tokyo-night-phone", "props": { "role": "composer" } }
            }
          ]
        }
      ]
    },
    {
      "id": "watch",
      "type": "block",
      "size": { "px": 1 },
      "content": { "mod": "tokyo-night-phone", "props": { "role": "watch" } }
    }
  ]
}
